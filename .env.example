# ============================================================================
# AWIS Backend — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file — only this .example file should be
# tracked in git. Confirm `.env` is listed in .gitignore.
# ============================================================================


# --- Database (Neon Postgres) ------------------------------------------------
# Get this from your Neon project dashboard -> Connection Details.
# NOTE: Neon gives you a plain "postgresql://" URL by default — you must
# manually change it to "postgresql+psycopg://" so SQLAlchemy uses the
# psycopg (v3) driver, which is what this project's requirements.txt expects.
DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<endpoint>.neon.tech/neondb?sslmode=require


# --- Task Queue (Upstash Redis) ----------------------------------------------
# Get this from your Upstash console -> Database -> Connect tab.
# Must be the TLS "rediss://" connection string, not the REST API URL —
# arq needs a real Redis protocol connection, not Upstash's HTTP SDK.
UPSTASH_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Legacy/local fallback — only used if UPSTASH_REDIS_URL is not set.
# Only relevant if you're running Redis locally via Docker instead of Upstash.
# REDIS_URL=redis://localhost:6379


# --- Auth (JWT) ---------------------------------------------------------------
# Used to sign/verify JWT access tokens issued at login/register.
# Generate a real random secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the placeholder value below outside local development.
JWT_SECRET_KEY=awis_dev_secret_key_change_in_production_12345


# --- Agent Pipeline Mode -------------------------------------------------------
# Set to "true" to run the small mock agent instead of the real deepagents
# pipeline — lets you test the full API/queue/DB flow without needing real
# LLM/tool API keys. Must be set in BOTH the FastAPI process AND the arq
# worker process separately (they are separate OS processes and do not
# share environment variables).
MOCK_AGENT=true


# --- Real Agent Pipeline (only required if MOCK_AGENT=false) ------------------
# Uncomment and fill in whichever of these your core/main.py pipeline
# actually uses. Only needed once you own/run the real agent pipeline.
# GROQ_API_KEY=
# TAVILY_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
