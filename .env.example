# ============================================================================
# AWIS Multi-Agent OSINT Environment Config
# ============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file — only this .example file should be
# tracked in git. Confirm `.env` is listed in .gitignore.
# ============================================================================


# --- NeonDB and Upstash Redis Connection Strings (Required by core/main.py) ---
DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<endpoint>.neon.tech/neondb?sslmode=require
UPSTASH_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# --- Agent Pipeline Mode -------------------------------------------------------
# Set to "true" to run the small mock agent instead of the real deepagents
# pipeline — lets you test the full API/queue/DB flow without needing real
# LLM/tool API keys. Must be set in BOTH the FastAPI process AND the arq
# worker process separately (they are separate OS processes and do not
# share environment variables).
MOCK_AGENT=true


# --- Real Agent Pipeline (only required if MOCK_AGENT=false) ------------------
# --- LLM Provider Keys (Required by core/main.py) ---
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- Tool Specific API Keys (Required by MCP Servers) ---
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
GITHUB_TOKEN=your_github_token_here
GH_TOKEN=your_gh_token_here

# --- MCP Server Endpoints (For AWIS LangChain Orchestrator) ---
# Used in src/tools/registry.py to load tools at runtime
MCP_SEARCH_SERVER_URL=http://localhost:8001/sse
MCP_ACADEMIC_SERVER_URL=http://localhost:8002/sse
MCP_DEV_SERVER_URL=http://localhost:8003/sse
MCP_MEDIA_SOCIAL_SERVER_URL=http://localhost:8004/sse
MCP_EXTRACTOR_SERVER_URL=http://localhost:8005/sse

# --- Langfuse Configuration (For AWIS LangChain Orchestrator) ---
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# --- Email Sending Configuration (For AWIS Email Sender Tool) ---
GMAIL_ADDRESS=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here